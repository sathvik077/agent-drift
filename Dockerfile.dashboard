# Agent Drift dashboard bundle.
#
# Two stages: build the production bundle with Node, then serve the static files. The API
# image can also serve the bundle directly; this image exists for deployments that want the
# frontend on its own origin.

FROM node:22-slim AS build

WORKDIR /build

COPY apps/dashboard/package.json apps/dashboard/package-lock.json* ./
# `npm ci` when a lockfile is present, otherwise a plain install. Both resolve the pinned
# versions in package.json.
RUN npm ci --no-audit --no-fund 2>/dev/null || npm install --no-audit --no-fund

COPY apps/dashboard/ ./
RUN node build.mjs \
 && test -f dist/app.js \
 && test -f dist/index.html \
 && test "$(stat -c%s dist/app.js)" -gt 50000

FROM nginx:1.27-alpine AS serve

COPY --from=build /build/dist /usr/share/nginx/html/assets
COPY --from=build /build/dist/index.html /usr/share/nginx/html/index.html

# The bundle calls the control plane at the same origin, so /api, /healthz, /docs and
# /openapi.json are proxied to the API service.
RUN printf '%s\n' \
  'server {' \
  '  listen 5173;' \
  '  server_name _;' \
  '  root /usr/share/nginx/html;' \
  '  index index.html;' \
  '  location /assets/ { try_files $uri =404; }' \
  '  location ~ ^/(api|healthz|docs|openapi.json) {' \
  '    proxy_pass http://api:8001;' \
  '    proxy_http_version 1.1;' \
  '    proxy_set_header Host $host;' \
  '    proxy_set_header Connection "";' \
  '    proxy_buffering off;          # server-sent events must not be buffered' \
  '    proxy_read_timeout 3600s;' \
  '  }' \
  '  location / { try_files $uri /index.html; }' \
  '}' > /etc/nginx/conf.d/default.conf

EXPOSE 5173

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget -q --spider http://127.0.0.1:5173/ || exit 1
