# Agent Drift — development and release commands.
#
# `make verify` is the release truth source. Everything else exists to make `verify`
# reproducible. No target fabricates a result: a command that cannot run in this
# environment fails loudly rather than printing a pass.

SHELL := /bin/bash
.DEFAULT_GOAL := help
.ONESHELL:

REPO_ROOT := $(shell pwd)
VENV      := $(REPO_ROOT)/.venv
PY        := $(VENV)/bin/python
PIP       := uv pip
PYTEST    := $(VENV)/bin/pytest
RUFF      := $(VENV)/bin/ruff
MYPY      := $(VENV)/bin/mypy
WHEELHOUSE := $(REPO_ROOT)/.wheelhouse

DASHBOARD := $(REPO_ROOT)/apps/dashboard
NODE_STORE := /opt/npm-tools/node_modules
NODE_MODULES := $(DASHBOARD)/node_modules
ESBUILD := $(NODE_MODULES)/.bin/esbuild
TSC := $(NODE_MODULES)/.bin/tsc

AD_API_PORT ?= 8001
AD_WEB_PORT ?= 5173
AD_DB_PATH  ?= $(REPO_ROOT)/var/agent_drift.db

export AD_FIXTURE_STATE ?= $(REPO_ROOT)/var/fixture
export AD_SANDBOX_ROOT  ?= $(AD_FIXTURE_STATE)/workspace
export PYTHONPATH := $(REPO_ROOT)/packages:$(REPO_ROOT)
export NODE_PATH := $(NODE_MODULES):$(NODE_STORE)

PYTHON_MIN := 3.12

RUN_DEPS := mcp==2.2.0 pydantic==2.13.5 starlette==1.6.0 sse-starlette==3.4.11 uvicorn==0.53.0 python-multipart==0.0.32
DEV_DEPS := pytest==9.1.1 httpx==0.28.1 ruff==0.16.8 mypy==2.3.1 setuptools==68.1.2

.PHONY: help
help: ## Show the available targets
	@echo "Agent Drift — make targets"
	@echo
	@grep -hE '^[a-zA-Z0-9_-]+:.*?## .*$$' $(MAKEFILE_LIST) \
	  | sort | awk 'BEGIN {FS = ":.*?## "}; {printf "  \033[1m%-18s\033[0m %s\n", $$1, $$2}'
	@echo
	@echo "Release gate:  make verify"
	@echo "Quick demo:    make setup && make demo && make dev"

# ------------------------------------------------------------------------- setup

.PHONY: setup
setup: ## Create the venv, install pinned deps, generate .env, init the database
	@set -euo pipefail
	mkdir -p var
	if [ ! -x "$(PY)" ]; then
	  # The project needs Python >= $(PYTHON_MIN). Ask uv for it explicitly rather than
	  # inheriting whatever `python3` happens to be, which on many systems is older and
	  # produces a confusing failure several steps later. uv downloads a standalone
	  # interpreter if the host has none; if it cannot, we say so plainly and stop.
	  if ! uv venv .venv --python $(PYTHON_MIN) --system-site-packages; then
	    echo
	    echo "ERROR: could not create a Python $(PYTHON_MIN) virtual environment."
	    echo "       Agent Drift requires Python >= $(PYTHON_MIN) (found: $$(python3 --version 2>&1))."
	    echo "       Install it, or let uv fetch one:  uv python install $(PYTHON_MIN)"
	    exit 1
	  fi
	fi
	echo "==> using $$($(PY) --version)"
	echo "==> installing pinned Python dependencies"
	if ! VIRTUAL_ENV=$(VENV) $(PIP) install -q $(RUN_DEPS) $(DEV_DEPS) 2>/dev/null; then
	  echo "    registry unavailable; falling back to the local offline wheelhouse"
	  $(PY) scripts/offline_bootstrap.py --python
	  VIRTUAL_ENV=$(VENV) $(PIP) install -q --no-index --find-links $(WHEELHOUSE) $(RUN_DEPS) $(DEV_DEPS)
	fi
	VIRTUAL_ENV=$(VENV) $(PIP) install -q -e . --no-deps --no-build-isolation
	echo "==> installing dashboard dependencies"
	if ! (cd $(DASHBOARD) && npm ci --silent --no-audit --no-fund 2>/dev/null); then
	  echo "    npm registry unavailable; linking pinned packages from the local store"
	  $(PY) scripts/offline_bootstrap.py --node
	fi
	$(MAKE) --no-print-directory env
	$(MAKE) --no-print-directory seed
	echo
	echo "setup complete."
	echo "  API will serve on       http://127.0.0.1:$(AD_API_PORT)"
	echo "  dashboard dev server on http://127.0.0.1:$(AD_WEB_PORT)"
	echo "  database                $(AD_DB_PATH)"
	echo "  admin token             see .env (AD_ADMIN_TOKEN)"

.PHONY: env
env: ## Generate .env with a fresh local admin token if it does not exist
	@set -euo pipefail
	if [ -f .env ]; then
	  echo "==> .env already exists, leaving it alone"
	else
	  TOKEN=$$($(PY) -c "import secrets; print(secrets.token_urlsafe(32))")
	  HMAC=$$($(PY) -c "import secrets; print(secrets.token_urlsafe(32))")
	  { echo "# Generated by \`make setup\`. Never commit this file."
	    echo "AD_API_PORT=$(AD_API_PORT)"
	    echo "AD_WEB_PORT=$(AD_WEB_PORT)"
	    echo "AD_DB_PATH=$(AD_DB_PATH)"
	    echo "AD_FIXTURE_STATE=$(AD_FIXTURE_STATE)"
	    echo "AD_SANDBOX_ROOT=$(AD_SANDBOX_ROOT)"
	    echo "AD_ADMIN_TOKEN=$$TOKEN"
	    echo "AD_AUDIT_HMAC_KEY=$$HMAC"
	    echo "AD_APPROVAL_TIMEOUT_S=60"
	    echo "AD_LOG_LEVEL=INFO"
	  } > .env
	  echo "==> wrote .env with a fresh admin token and audit signing key"
	fi

.PHONY: seed
seed: ## Create the demo contracts and the sandbox fixture tree
	@$(PY) -m agent_drift.cli seed --db $(AD_DB_PATH)

.PHONY: demo
demo: ## Reset state and run all bundled scenarios through a real gateway
	@set -euo pipefail
	$(PY) -m agent_drift.cli reset --db $(AD_DB_PATH) >/dev/null
	$(PY) -m agent_drift.cli seed --db $(AD_DB_PATH) >/dev/null
	$(PY) scripts/run_scenarios.py --db $(AD_DB_PATH)

# --------------------------------------------------------------------- services

.PHONY: dev
dev: build-dashboard ## Run the API and the dashboard watcher with clean teardown
	@$(PY) scripts/dev.py

.PHONY: api
api: ## Run only the control plane
	@$(PY) -m agent_drift.cli api --port $(AD_API_PORT) --db $(AD_DB_PATH)

.PHONY: gateway
gateway: ## Run a gateway bound to the read-only demo task (stdio; for MCP hosts)
	@$(PY) -m agent_drift.cli gateway --task-id demo-repo-review --db $(AD_DB_PATH)

# ------------------------------------------------------------------------ checks

.PHONY: smoke
smoke: ## Real MCP client -> gateway -> upstream allow/deny check with counters
	@$(PY) -m agent_drift.cli smoke --db $(REPO_ROOT)/var/smoke.db

.PHONY: test
test: ## Run unit, security and integration suites
	@$(PYTEST) tests/unit tests/security tests/integration -q

.PHONY: test-all
test-all: ## Run every suite including the browser end-to-end tests
	@$(PYTEST) tests -q

.PHONY: e2e
e2e: build-dashboard ## Run the Playwright end-to-end suite against a live server
	@$(PYTEST) tests/e2e -q

.PHONY: lint
lint: ## Ruff for Python, tsc for the dashboard
	@set -euo pipefail
	$(RUFF) check packages apps tests evals scripts examples
	$(RUFF) format --check packages apps tests evals scripts examples
	$(MAKE) --no-print-directory typecheck-web

.PHONY: fmt
fmt: ## Apply Ruff formatting and import ordering
	@$(RUFF) check --fix packages apps tests evals scripts examples
	@$(RUFF) format packages apps tests evals scripts examples

.PHONY: typecheck
typecheck: ## mypy for the package, tsc for the dashboard
	@set -euo pipefail
	$(MYPY) --config-file pyproject.toml
	$(MAKE) --no-print-directory typecheck-web

.PHONY: typecheck-web
typecheck-web: $(NODE_MODULES) ## tsc --noEmit for the dashboard
	@cd $(DASHBOARD) && node $(TSC) --noEmit -p tsconfig.json && echo "dashboard: typecheck clean"

$(NODE_MODULES):
	@$(PY) scripts/offline_bootstrap.py --node

.PHONY: build-dashboard
build-dashboard: $(NODE_MODULES) ## Produce the production dashboard bundle
	@cd $(DASHBOARD) && node build.mjs

.PHONY: build
build: build-dashboard ## Build the dashboard bundle and the Python wheel
	@set -euo pipefail
	$(MAKE) --no-print-directory typecheck-web
	test -f $(DASHBOARD)/dist/app.js || { echo "dashboard bundle missing"; exit 1; }
	test -f $(DASHBOARD)/dist/index.html || { echo "dashboard index missing"; exit 1; }
	echo "build: dashboard bundle $$(du -h $(DASHBOARD)/dist/app.js | cut -f1)"

.PHONY: eval
eval: ## Run the offline benchmark and write evals/RESULTS.{json,md}
	@$(PY) evals/run_eval.py --out evals

.PHONY: screenshots
screenshots: build-dashboard ## Capture dashboard screenshots from the running system
	@$(PY) scripts/capture_screenshots.py --publish

.PHONY: verify
verify: ## RELEASE GATE: lint, typecheck, tests, smoke, eval, dataset and asset gates
	@$(PY) scripts/verify.py

.PHONY: docker-build
docker-build: ## Build the API and dashboard images (requires a reachable registry)
	@set -euo pipefail
	docker build -f Dockerfile.api -t agent-drift-api:dev .
	docker build -f Dockerfile.dashboard -t agent-drift-dashboard:dev .

.PHONY: verify-audit
verify-audit: ## Recompute the audit HMAC chain
	@$(PY) -m agent_drift.cli verify-audit --db $(AD_DB_PATH)

# ------------------------------------------------------------------------ hygiene

.PHONY: clean-demo
clean-demo: ## Clear the local database, sandbox fixture and captured screenshots
	@$(PY) -m agent_drift.cli reset --db $(AD_DB_PATH)
	rm -f $(REPO_ROOT)/var/smoke.db $(REPO_ROOT)/var/smoke.db-wal $(REPO_ROOT)/var/smoke.db-shm
	rm -f $(REPO_ROOT)/var/scen.db $(REPO_ROOT)/var/scen.db-wal $(REPO_ROOT)/var/scen.db-shm

.PHONY: clean
clean: clean-demo ## clean-demo plus build outputs and caches
	@rm -rf $(DASHBOARD)/dist .pytest_cache .ruff_cache .mypy_cache
	find . -name __pycache__ -type d -prune -exec rm -rf {} + 2>/dev/null || true
