# Agent Drift local configuration.
#
# `make setup` generates a real `.env` from this template with fresh random secrets.
# `.env` is gitignored; this example file is committed and contains no secrets.

# ---- local service addresses -------------------------------------------------
# The control plane binds to 127.0.0.1 only. Loopback binding is defence in depth,
# not authentication: the bearer token below is what actually protects mutations.
AD_API_PORT=8001
AD_WEB_PORT=5173

# ---- state -------------------------------------------------------------------
AD_DB_PATH=var/agent_drift.db
AD_FIXTURE_STATE=var/fixture
AD_SANDBOX_ROOT=var/fixture/workspace

# ---- authentication ----------------------------------------------------------
# Required for every mutating control-plane request (registering a contract,
# approving or declining a pending action). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# If this is unset, mutating requests fail closed with HTTP 503 rather than being
# allowed. Automated tests may set AD_DISABLE_AUTH=1 instead, which is an explicit
# opt-out, never a default.
AD_ADMIN_TOKEN=replace-me-with-a-generated-token

# ---- audit integrity chain (optional) ----------------------------------------
# When set, each event is HMAC-chained to its predecessor and `make verify-audit`
# recomputes the chain. This is tamper-evidence under a separately held key, not a
# guarantee: a host compromise that can read this key can also forge the chain.
# Leaving it unset is reported as "not configured", never as "verified".
AD_AUDIT_HMAC_KEY=

# ---- behaviour ---------------------------------------------------------------
# How long the gateway waits for a human decision on an approval-gated call before
# denying it. A timeout denies; it never auto-approves.
AD_APPROVAL_TIMEOUT_S=60
# Time-to-live of an issued approval grant.
AD_APPROVAL_TTL_S=300
# Gateway and API log level. Gateway logs go to stderr only; stdout carries the
# stdio JSON-RPC stream.
AD_LOG_LEVEL=INFO

# ---- CORS --------------------------------------------------------------------
# Comma-separated origin allowlist. Defaults to the local dashboard origins.
# AD_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# ---- test-only ---------------------------------------------------------------
# Set to 1 to disable bearer auth on mutating requests. Only for automated tests.
# AD_DISABLE_AUTH=0
# Set to 1 to make the fixture upstream re-advertise mutated tool metadata, which
# is how the manifest rug-pull scenario produces genuine drift.
# AD_FIXTURE_MUTATE_MANIFEST=0

# ---- not required ------------------------------------------------------------
# Agent Drift needs no model API keys. The default demo, every test and the whole
# evaluation run entirely offline against deterministic local fixtures.
